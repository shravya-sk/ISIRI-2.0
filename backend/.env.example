# Application Settings
APP_NAME=ISIRI 2.0 Backend
APP_VERSION=2.0.0
DEBUG=True

# Server Settings
HOST=0.0.0.0
PORT=8000

# Environment
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Raspberry Pi door lock (hardware/rpi_gpio_service.py)
# ---------------------------------------------------------------------------
# Copy this file to backend/.env and edit. backend/.env is git-ignored, which
# matters here: the zone ID below names an interface on YOUR machine, so the
# correct value is different on every PC and must never be committed.

# Where the Pi's lock daemon is listening. Accepted forms:
#   192.168.1.50                      (IPv4, port defaults to 5000)
#   192.168.1.50:5000
#   raspberrypi.local:5000
#   [2409:40f2:300b::42]:5000         (global IPv6)
#   [fe80::ba27:ebff:fe12:3456%wlan0]:5000    <- Linux/macOS link-local
#   [fe80::ba27:ebff:fe12:3456%12]:5000       <- Windows link-local
#
# The text after '%' is the ZONE ID: the interface on THIS computer that faces
# the Pi -- not the Pi's own interface. Find it with:
#   Linux/macOS : ip -6 addr        (use the device name, e.g. wlan0)
#   Windows     : netsh interface ipv6 show interfaces   (use the numeric Idx)
# Write it RAW here ('%12'), not percent-encoded ('%2512'). The %25 spelling is
# only for URLs you paste into curl or a browser.
RPI_HOST=[fe80::ba27:ebff:fe12:3456%wlan0]:5000

# 'false' (the default) talks to the real Pi. Set 'true' to develop with no Pi
# attached -- replies are then explicitly labelled as simulated.
HARDWARE_SIMULATION=false

# Seconds to wait for the Pi before giving up.
RPI_TIMEOUT=2.0
